# Alta Vibración — environment template. Copy to .env.local and fill in.
# Public values (NEXT_PUBLIC_*) are inlined into the client bundle.
# Server-side secrets (non-prefixed, e.g. the booking section below) are NEVER sent to
# the browser — keep them only in .env.local (gitignored) or Vercel's encrypted env store.

# WhatsApp business number for the "Agenda tu cita" CTA / click-to-chat.
# wa.me format: country code first, digits only, no '+' or spaces.
# Optional override — lib/site.ts already defaults to the real AV line.
NEXT_PUBLIC_WHATSAPP_NUMBER=573217413770

# ─── Booking / Google Calendar (epic #31, Phase 1) ─────────────────────────
# SERVER-SIDE ONLY — these are SECRETS, never prefix with NEXT_PUBLIC_.
# Full setup steps: docs/booking-setup.md
#
# The whole service-account JSON key, base64-encoded as a single line
# (base64 avoids the classic GOOGLE_PRIVATE_KEY "\n" escape-mangling bug):
#   cat service-account.json | base64 -w0
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
#
# Liliana's calendar id = her gmail address (the calendar she shares with the
# service account). NEVER "primary" (the SA's own primary calendar is empty).
LILIANA_CALENDAR_ID=lp.tobon.miranda@gmail.com
