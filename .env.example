# Alta Vibración — environment template. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are inlined into the browser bundle. Everything else is
# server-only and must live in .env.local (gitignored) or Vercel's env store.

# WhatsApp line for click-to-chat CTAs (wa.me format: country code first, digits only).
# Optional; lib/site.ts defaults to the real Alta Vibración line.
NEXT_PUBLIC_WHATSAPP_NUMBER=573217413770

# Canonical production origin for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://altavibracion.resuelv.com

# Postgres connection string for the agenda. Local: the Docker container from
# docs/agenda-setup.md. Production: Neon's POOLED connection string (host ends
# in -pooler, sslmode=require). When unset, /agenda falls back to WhatsApp.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/altavibracion

# Basic-auth credentials for /admin. Required for the admin page to open at all.
ADMIN_USER=
ADMIN_PASSWORD=

# Hours a pending booking blocks its slot while Liliana verifies the transfer.
BOOKING_HOLD_HOURS=24
